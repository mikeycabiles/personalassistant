# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Calendar
GOOGLE_CALENDAR_ID=yourname@gmail.com
GOOGLE_CREDENTIALS_JSON=base64_encoded_credentials_json_here
GOOGLE_TOKEN_JSON=base64_encoded_token_json_here

# App Config
USER_TIMEZONE=America/New_York
ENVIRONMENT=development
WEBHOOK_URL=https://your-app-name.railway.app
PORT=8080

# Kiki refuses to schedule on any day with an all-day event whose title
# (case-insensitive) contains any of these comma-separated substrings.
# Override only if you want different markers; the defaults cover most cases.
# BLOCKED_DAY_KEYWORDS=office,ooo,out of office,onsite,in-person,w2,do not schedule
